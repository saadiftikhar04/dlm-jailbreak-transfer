    "decision_log": [
        {
            "decision": "D2",
            "date": "2026-10-03",
            "ruling": "Choose the preferred Llama identity repair: rerun PiF and MetaCipher on Llama-3.1-8B-Instruct over the canonical pool with matched plaintext controls; retain Llama-3.2-3B as a separate sensitivity record.",
            "rationale": "Creates one checkpoint identity for the primary three-attack profile. G1 remains unsubmitted pending the task-specific compute approval gate."
        },
        {
            "decision": "D3",
            "date": "2026-10-02",
            "ruling": "Primary common judge is nvidia/nemotron-3-ultra-550b-a55b:free via OpenRouter; temperature=0, top_p=1, max_tokens=256; six-category rubric is frozen in submissions/TMLR/r4_plan.txt.",
            "rationale": "Free route verified at zero reported cost; non-DeepSeek general reasoning model selected for request-conditioned compliance categories. No outcome-based selection."
        },
        {
            "decision": "D5",
            "date": "2026-10-04",
            "ruling": "Do not conduct human calibration. No author annotation is assigned, no external annotator has been recruited or approved, and no human-labeling run is authorized. Mark J4 not conducted and retain the human-calibration gap as a limitation.",
            "rationale": "The author explicitly ruled out author annotation; no external annotator is available. Automated-judge agreement must not be presented as accuracy or human ground truth."
        },
        {
            "decision": "D4",
            "date": "2026-10-03",
            "ruling": "Primary ASR@1 is the D3 verdict on the first victim response for the first eligible attack candidate per canonical prompt; no best-of-N response selection. Secondary ASR@k is cumulative D3 success over sequential victim queries, with k=50 for PiF, k=5 for MetaCipher, and k=50 for ArrAttack, and per-prompt query counts. Describe the as-run MetaCipher Q-table and the PiF/ArrAttack feedback stops as adaptive components; do not call this a fixed causal-to-target transfer.",
            "rationale": "The selected later MetaCipher responses and PiF final responses do not supply a uniform first-query outcome. Missing first-response outputs remain explicitly unresolved and G3 is gated."
        },
        {
            "decision": "D6",
            "date": "2026-10-02",
            "ruling": "Encrypt and retain full response fields in institutionally controlled storage until 12 months after the final editorial decision, then securely delete. Allow approved, logged, time-limited read-only verification under a data-use agreement; retain metadata, verdicts, aggregates, sanitized examples, and hashes thereafter.",
            "rationale": "Adopt gated retention rather than deletion at review close, subject to confirming institutional storage and access-control capability before release."
        },
        {
            "decision": "D7",
            "date": "2026-10-03",
            "ruling": "Freeze Wilson intervals, paired McNemar tests, Cochran's Q for three-attack comparisons, Holm adjustment within attack-control and attack-pair families, and 10,000 prompt/duplicate-cluster bootstrap replicates with seed 20261002. Primary controls are matched on prompt identity, D3 judge, and each unique victim decoder configuration; family/portfolio summaries are descriptive, and the mixed-effects family inference is withdrawn.",
            "rationale": "Pre-registers analyses before any new outcome judging. D7 details are frozen in submissions/TMLR/r4_plan.txt."
        }
    ],
