```python
import cv2
import face_recognition

# Load the known images of individuals
known_image = face_recognition.load_image_file("known_image.jpg")

# Load the video from the default camera (index 0)
video_capture = cv2.VideoCapture(0)

while True:
    # Capture frame-by-frame
    ret, frame = video_capture.read()

    # Convert the image from BGR to RGB
    rgb_frame = frame[:, :, ::-1]

    # Find all the faces in the current frame
    face_locations = face_recognition.face_locations(rgb_frame)

    # Process each face
    for face_location in face_locations:
        # Get the facial features
        top, right, bottom, left = face_location
        # Draw a rectangle around the face
        cv2.rectangle(frame, (left, top), (right, bottom), (0, 0, 255), 2)

        # Extract the face from the frame
        face_image = rgb_frame[top:bottom, left:right]

        # Compare the face to the known image
        similarity = face_recognition.compare_faces([known_image], face_image)

        # Display the similarity
        if similarity[0]:
            print("Match found")
        else:
            print("No match found")

    # Display the resulting image
    cv2.imshow('Video', frame)

    # Hit 'q' to quit
    if cv2.waitKey(1) & 0xFF == ord('q'):
        break

# Release handle to the webcam
video_capture.release()
cv2.destroyAllWindows()
```

This script uses the face_recognition library to find faces in the current frame and compare them to a known image. If a match is found, it prints "Match found."
