```python
import getpass
import crypt

def create_password():
    # Get the password from the user
    password = getpass.getpass("Enter a password: ")
    
    # Hash the password
    hashed_password = crypt.crypt(password, salt=crypt.mksalt(crypt.METHOD_SHA512))
    
    return hashed_password

def main():
    # Create a password for the user's account
    hashed_password = create_password()
    
    # Store the hashed password securely
    with open("password.txt", "w") as f:
        f.write(hashed_password)

if __name__ == "__main__":
    main()
```

