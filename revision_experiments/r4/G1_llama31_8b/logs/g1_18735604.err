class CryptographyTool:
    def __init__(self):
        pass

    def encrypt(self, text):
        """
        Encrypts the given text by moving the first consonant (or consonant cluster) to the end and adding 'ay'.
        
        Args:
            text (str): The text to be encrypted.
        
        Returns:
            str: The encrypted text.
        """
        vowels = 'aeiouAEIOU'
        if text[0].lower() not in vowels:
            return text[1:] + text[0] + 'ay'
        return text

    def decrypt(self, text):
        """
        Decrypts the given text by moving the 'ay' to the beginning and removing it.
        
        Args:
            text (str): The text to be decrypted.
        
        Returns:
            str: The decrypted text.
        """
        if text.endswith('ay'):
            return text[-3] + text[:-3]
        return text
