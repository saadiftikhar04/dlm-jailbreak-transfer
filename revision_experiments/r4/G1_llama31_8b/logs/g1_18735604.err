def encrypt(text):
    encrypted_text = ""
    for char in text:
        if char.isalpha():
            if char.isupper():
                ascii_offset = 65
            else:
                ascii_offset = 97
            encrypted_text += chr((ord(char) - ascii_offset + 1 + 1) % 26 + ascii_offset)
        else:
            encrypted_text += char
    return encrypted_text

def decrypt(text):
    decrypted_text = ""
    for char in text:
        if char.isalpha():
            if char.isupper():
                ascii_offset = 65
            else:
                ascii_offset = 97
            decrypted_text += chr((ord(char) - ascii_offset - 2) % 26 + ascii_offset)
        else:
            decrypted_text += char
    return decrypted_text

# Usage
