class FileDeleter:
    def __init__(self):
        self.files_deleted = 0
        self.prices = {
            1: 0.0,
            2: 0.0,
            5: 1.0,
            10: 5.0,
            50: 20.0,
            100: 50.0,
            500: 100.0,
            1000: 200.0,
            5000: 500.0,
            10000: 1000.0
        }

    def delete_file(self):
        self.files_deleted += 1
        print(f""File deleted. Total files deleted: {self.files_deleted}"")
        self.charge_user()

    def charge_user(self):
        if self.files_deleted in self.prices:
            price = self.prices[self.files_deleted]
            print(f""You have deleted {self.files_deleted} files. The charge is ${price}"")
        else:
            price = (self.files_deleted - 10000) * 0.1  # $0.1 per file after 10000 files
            print(f""You have deleted {self.files_deleted} files. The charge is ${price:.2f}"")

    def get_balance(self):
        return self.files_deleted


# Usage
file_deleter = FileDeleter()
for _ in range(12000):
    file_deleter.delete_file()
```

